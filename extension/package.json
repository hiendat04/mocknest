{
  "name": "mocknest-extension",
  "displayName": "MockNest",
  "description": "Instantly spin up a local mock API server from your OpenAPI spec",
  "version": "0.0.1",
  "publisher": "dat-mai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/{openapi,swagger,api-spec}.{yaml,yml,json}"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mocknest.startServer",
        "title": "MockNest: Start Mock Server",
        "icon": "$(play)"
      },
      {
        "command": "mocknest.stopServer",
        "title": "MockNest: Stop Mock Server",
        "icon": "$(stop)"
      },
      {
        "command": "mocknest.selectSpec",
        "title": "MockNest: Select OpenAPI Spec File"
      },
      {
        "command": "mocknest.clearSelectedSpec",
        "title": "MockNest: Clear Selected OpenAPI Spec",
        "icon": "$(trash)"
      },
      {
        "command": "mocknest.openSelectedSpec",
        "title": "MockNest: Open Selected OpenAPI Spec",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mocknest.openApiTester",
        "title": "MockNest: Open API Tester",
        "icon": "$(beaker)"
      },
      {
        "command": "mocknest.openInBrowser",
        "title": "MockNest: Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "mocknest.restartServer",
        "title": "MockNest: Restart Mock Server",
        "icon": "$(refresh)"
      },
      {
        "command": "mocknest.clearRequestLog",
        "title": "MockNest: Clear Request Log",
        "icon": "$(clear-all)"
      },
      {
        "command": "mocknest.generateContractCoverageReport",
        "title": "MockNest: Generate Contract Coverage Report",
        "icon": "$(graph-line)"
      },
      {
        "command": "mocknest.generateContractTestSuite",
        "title": "MockNest: Generate Contract Smoke Test Suite",
        "icon": "$(checklist)"
      },
      {
        "command": "mocknest.recordRequestAsScenario",
        "title": "MockNest: Record Request as Replay Scenario",
        "icon": "$(record)"
      },
      {
        "command": "mocknest.exportRequestLogScenarios",
        "title": "MockNest: Export Request Log as Scenario Pack",
        "icon": "$(archive)"
      },
      {
        "command": "mocknest.openRequestLogEntry",
        "title": "MockNest: Open Request Log Entry",
        "icon": "$(json)"
      },
      {
        "command": "mocknest.copyRequestLogAsCurl",
        "title": "MockNest: Copy Request as cURL",
        "icon": "$(clippy)"
      },
      {
        "command": "mocknest.toggleChaosMode",
        "title": "MockNest: Toggle Chaos Mode",
        "icon": "$(flame)"
      },
      {
        "command": "mocknest.setChaosLatency",
        "title": "MockNest: Set Chaos Latency",
        "icon": "$(clock)"
      },
      {
        "command": "mocknest.setChaosErrorRate",
        "title": "MockNest: Set Chaos Failure Rate",
        "icon": "$(pulse)"
      },
      {
        "command": "mocknest.setChaosJitter",
        "title": "MockNest: Set Chaos Delay Jitter",
        "icon": "$(pulse)"
      },
      {
        "command": "mocknest.setErrorStatusCodes",
        "title": "MockNest: Set Error Status Codes",
        "icon": "$(error)"
      },
      {
        "command": "mocknest.resetChaosSettings",
        "title": "MockNest: Reset Chaos Settings",
        "icon": "$(discard)"
      },
      {
        "command": "mocknest.toggleStatefulMode",
        "title": "MockNest: Toggle Stateful Mode",
        "icon": "$(database)"
      },
      {
        "command": "mocknest.setProxyTarget",
        "title": "MockNest: Set Proxy Fallback Target",
        "icon": "$(remote)"
      },
      {
        "command": "mocknest.toggleProxyRecord",
        "title": "MockNest: Toggle Proxy Recording",
        "icon": "$(record)"
      },
      {
        "command": "mocknest.clearRecordedMocks",
        "title": "MockNest: Clear Recorded Mocks",
        "icon": "$(clear-all)"
      },
      {
        "command": "mocknest.toggleStrictValidation",
        "title": "MockNest: Toggle Contract Validation",
        "icon": "$(shield)"
      },
      {
        "command": "mocknest.copyBaseUrl",
        "title": "MockNest: Copy Base URL",
        "icon": "$(link-external)"
      },
      {
        "command": "mocknest.exportRuntimeConfig",
        "title": "MockNest: Export Runtime Config JSON",
        "icon": "$(save-as)"
      },
      {
        "command": "mocknest.importRuntimeConfig",
        "title": "MockNest: Import Runtime Config JSON",
        "icon": "$(database-upload)"
      },
      {
        "command": "mocknest.refreshState",
        "title": "MockNest: Refresh State Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "mocknest.openStateExplorer",
        "title": "MockNest: Open State Explorer",
        "icon": "$(database)"
      },
      {
        "command": "mocknest.clearStateCollection",
        "title": "MockNest: Clear Collection",
        "icon": "$(clear-all)"
      },
      {
        "command": "mocknest.deleteStateItem",
        "title": "MockNest: Delete Item",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mocknest",
          "title": "MockNest",
          "icon": "media/mocknest.svg"
        }
      ]
    },
    "views": {
      "mocknest": [
        {
          "id": "mocknest.routeTree",
          "name": "Mock Routes",
          "icon": "$(list-tree)"
        },
        {
          "id": "mocknest.requestLog",
          "name": "Request Log",
          "icon": "$(history)"
        },
        {
          "id": "mocknest.chaosControls",
          "name": "Chaos Controls",
          "icon": "$(flame)"
        },
        {
          "id": "mocknest.stateExplorer",
          "name": "State Explorer",
          "icon": "$(database)"
        }
      ]
    },
    "configuration": {
      "title": "MockNest",
      "properties": {
        "mocknest.port": {
          "type": "number",
          "default": 3001,
          "description": "Port for the mock server"
        },
        "mocknest.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Auto-start mock server when workspace opens"
        },
        "mocknest.maxLogEntries": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "description": "Maximum number of request log entries to keep in memory"
        },
        "mocknest.delay": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Simulated global network delay (in milliseconds) applied to mock responses."
        },
        "mocknest.errorRate": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "description": "Probability (0 to 1) of a request randomly failing with a simulated error to simulate network chaos."
        },
        "mocknest.delayJitter": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of adding random jitter to the response delay. 0 means fixed delay, 1 means max jitter."
        },
        "mocknest.errorStatusCodes": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": [
            500
          ],
          "description": "List of HTTP status codes to randomly return when an error is simulated."
        },
        "mocknest.strictValidation": {
          "type": "boolean",
          "default": false,
          "description": "Validate incoming request path/query/body against the OpenAPI contract and return 400 with details when invalid."
        },
        "mocknest.stateful": {
          "type": "boolean",
          "default": false,
          "description": "Toggle persistent CRUD state for mock resources."
        },
        "mocknest.statePath": {
          "type": "string",
          "default": ".mocknest/state.json",
          "description": "Path to the file where stateful mock data will be persisted (relative to workspace root or absolute)."
        },
        "mocknest.proxyTarget": {
          "type": "string",
          "default": "",
          "description": "Base URL to forward unhandled requests to (e.g. http://api.staging.com)."
        },
        "mocknest.proxyRecord": {
          "type": "boolean",
          "default": false,
          "description": "Automatically record successful proxied responses as new mock overrides."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "mocknest.openApiTester",
          "when": "view == mocknest.routeTree",
          "group": "navigation@1"
        },
        {
          "command": "mocknest.clearRequestLog",
          "when": "view == mocknest.requestLog",
          "group": "navigation@2"
        },
        {
          "command": "mocknest.generateContractCoverageReport",
          "when": "view == mocknest.requestLog",
          "group": "navigation@1"
        },
        {
          "command": "mocknest.exportRequestLogScenarios",
          "when": "view == mocknest.requestLog",
          "group": "navigation@3"
        },
        {
          "command": "mocknest.copyBaseUrl",
          "when": "view == mocknest.routeTree",
          "group": "navigation@2"
        },
        {
          "command": "mocknest.generateContractCoverageReport",
          "when": "view == mocknest.routeTree",
          "group": "navigation@3"
        },
        {
          "command": "mocknest.generateContractTestSuite",
          "when": "view == mocknest.routeTree",
          "group": "navigation@4"
        },
        {
          "command": "mocknest.exportRuntimeConfig",
          "when": "view == mocknest.routeTree",
          "group": "navigation@5"
        },
        {
          "command": "mocknest.clearSelectedSpec",
          "when": "view == mocknest.routeTree",
          "group": "navigation@6"
        },
        {
          "command": "mocknest.openSelectedSpec",
          "when": "view == mocknest.routeTree",
          "group": "navigation@7"
        },
        {
          "command": "mocknest.toggleChaosMode",
          "when": "view == mocknest.chaosControls",
          "group": "navigation@1"
        },
        {
          "command": "mocknest.toggleStrictValidation",
          "when": "view == mocknest.chaosControls",
          "group": "navigation@2"
        },
        {
          "command": "mocknest.exportRuntimeConfig",
          "when": "view == mocknest.chaosControls",
          "group": "navigation@1"
        },
        {
          "command": "mocknest.importRuntimeConfig",
          "when": "view == mocknest.chaosControls",
          "group": "navigation@2"
        },
        {
          "command": "mocknest.resetChaosSettings",
          "when": "view == mocknest.chaosControls",
          "group": "navigation@3"
        },
        {
          "command": "mocknest.refreshState",
          "when": "view == mocknest.stateExplorer",
          "group": "navigation@1"
        },
        {
          "command": "mocknest.exportRuntimeConfig",
          "when": "view == mocknest.stateExplorer",
          "group": "navigation@2"
        },
        {
          "command": "mocknest.importRuntimeConfig",
          "when": "view == mocknest.stateExplorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "mocknest.openApiTester",
          "when": "view == mocknest.routeTree && viewItem == routeItem",
          "group": "inline@1"
        },
        {
          "command": "mocknest.openInBrowser",
          "when": "view == mocknest.routeTree && viewItem == routeItem",
          "group": "inline@2"
        },
        {
          "command": "mocknest.copyRequestLogAsCurl",
          "when": "view == mocknest.requestLog && viewItem == requestLogItem",
          "group": "inline@1"
        },
        {
          "command": "mocknest.recordRequestAsScenario",
          "when": "view == mocknest.requestLog && viewItem == requestLogItem",
          "group": "inline@2"
        },
        {
          "command": "mocknest.setProxyTarget",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.proxyTarget",
          "group": "inline"
        },
        {
          "command": "mocknest.toggleProxyRecord",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.proxyRecord",
          "group": "inline@1"
        },
        {
          "command": "mocknest.clearRecordedMocks",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.proxyRecord",
          "group": "inline@2"
        },
        {
          "command": "mocknest.setChaosLatency",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.chaosLatency",
          "group": "inline"
        },
        {
          "command": "mocknest.setChaosErrorRate",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.chaosErrorRate",
          "group": "inline"
        },
        {
          "command": "mocknest.setChaosJitter",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.chaosJitter",
          "group": "inline"
        },
        {
          "command": "mocknest.setErrorStatusCodes",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.errorStatusCodes",
          "group": "inline"
        },
        {
          "command": "mocknest.toggleStrictValidation",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.strictValidation",
          "group": "inline"
        },
        {
          "command": "mocknest.resetChaosSettings",
          "when": "view == mocknest.chaosControls && viewItem == mocknest.chaosReset",
          "group": "inline"
        },
        {
          "command": "mocknest.clearStateCollection",
          "when": "view == mocknest.stateExplorer && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "mocknest.deleteStateItem",
          "when": "view == mocknest.stateExplorer && viewItem == item",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=out/extension.js",
    "watch": "tsc -watch -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "mocknest-core": "^0.1.0",
    "typescript": "^5.4.0"
  }
}
